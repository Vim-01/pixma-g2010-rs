[Unit]
Description=Canon PIXMA G2010 USB Multiplexer & Hardware Telemetry Daemon
Documentation=https://github.com/Vim-01/pixma-g2010-rs
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/pixmad --require-hardware --socket /run/pixma/pixmad.sock --state-file /var/lib/pixma-g2010/state.json
RuntimeDirectory=pixma
RuntimeDirectoryMode=0775
StateDirectory=pixma-g2010
StateDirectoryMode=0755
Group=lp
SupplementaryGroups=scanner
Restart=on-failure
RestartSec=10s
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=/dev/bus/usb -/run/lock

[Install]
WantedBy=multi-user.target
